# Copy to .env and fill in. Never commit .env.

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# openai | extractive (no key needed: answers with the best passages instead of generated text)
LLM_PROVIDER=openai
# local (sentence-transformers, needs the full image) | hash (offline, word matching only)
EMBEDDING_PROVIDER=local
# false = build a small AI image without torch (use with EMBEDDING_PROVIDER=hash)
INSTALL_LOCAL_MODEL=true

# ---- Secrets: change all of these ----
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_PASSWORD=change-me-rabbit
S3_SECRET_KEY=change-me-storage-secret
# at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SERVICE_TOKEN=change-me-service-token

# ---- Accounts registered with these emails become admins (comma separated) ----
ADMIN_EMAILS=

# ---- Limits ----
QUESTIONS_PER_MINUTE=20
UPLOADS_PER_DAY=50
